# Workday MCP — Cloud Environment Variables
# Copy this to .env and fill in your values

# Required
WORKDAY_BASE_URL=https://wd115.myworkday.com
WORKDAY_TENANT=lilly

# Cloud transport (do not change for cloud deployment)
MCP_TRANSPORT=streamable-http
MCP_PORT=8000

# Optional
WORKDAY_AUTH_TIMEOUT_SECONDS=300
WORKDAY_LOG_LEVEL=INFO
# WORKDAY_CA_BUNDLE=/path/to/ca-cert.pem
# WORKDAY_ENABLE_RAW_GET=1
